{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FEMAPP_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Debug, default compiler)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (default compiler)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FEMAPP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows / MSVC",
      "inherits": "ci-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS / Apple Clang",
      "inherits": "ci-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-femapp"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux / GCC",
      "inherits": "ci-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux-femapp"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux / Clang",
      "inherits": "ci-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux-femapp"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "macos-clang", "configurePreset": "macos-clang" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "test-base", "configurePreset": "dev" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "windows-msvc", "inherits": "test-base", "configurePreset": "windows-msvc" },
    { "name": "macos-clang", "inherits": "test-base", "configurePreset": "macos-clang" },
    { "name": "linux-gcc", "inherits": "test-base", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "inherits": "test-base", "configurePreset": "linux-clang" }
  ]
}
